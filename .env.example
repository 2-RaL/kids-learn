# ──────────────────────────────────────────────────
# Kids Move & Learn — Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# On Hostinger, set these in the Environment Variables section.
# ──────────────────────────────────────────────────

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT Secret Key (use a long random string in production)
JWT_SECRET=

# Default Admin Account (created on first startup if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server Port (Hostinger usually assigns this automatically)
PORT=3000
